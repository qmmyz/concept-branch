# Optional runtime overrides. Export these variables before starting the app.
CONCEPT_BRANCH_HOST=127.0.0.1
CONCEPT_BRANCH_PORT=8421
CONCEPT_BRANCH_DB=./var/concept-branch.sqlite3
CONCEPT_BRANCH_CONFIG_DIR=./var/config

# Set to 1 only when the app is served through HTTPS.
CONCEPT_BRANCH_SECURE_COOKIES=0

# Development server origins, comma-separated. Same-origin production needs no extra origin.
CONCEPT_BRANCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
